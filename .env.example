DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_publishable_key
SUPABASE_SECRET_KEY=your_secret_key
SUPABASE_KEY=your_anon_public_jwt
SUPABASE_SERVICE_KEY=your_service_role_jwt
SUPABASE_PROJECT_ID=your_project_id
SUPABASE_STORAGE_BUCKET=project-files

BYTEZ_API_KEY=your_bytez_api_key

STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Used for OAuth redirect URLs (must match Site URL / redirect allowlist in Supabase).
PUBLIC_SITE_URL=http://127.0.0.1:8000

# Google sign-in: add the same OAuth Client ID and Client Secret in the Supabase Dashboard
# under Authentication → Providers → Google (not in this file for production).
# In Google Cloud Console, set Authorized redirect URI to:
#   https://<your-project-ref>.supabase.co/auth/v1/callback
# In Supabase → Authentication → URL Configuration, add redirect:
#   <PUBLIC_SITE_URL>/auth/google/callback/

# Paystack (subscription checkout) — prefer PAYSTACK_*; VITE_PAYSTACK_* also supported
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=you@example.com
EMAIL_HOST_PASSWORD=app-password
